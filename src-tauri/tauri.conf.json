{
  "productName": "pdfsign",
  "version": "0.1.0",
  "identifier": "app.pdfsign.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node scripts/copy-frontend.js",
    "beforeBuildCommand": "node scripts/copy-frontend.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "pdfsign",
        "width": 1280,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utilities",
    "shortDescription": "Sign PDF documents with a smartcard",
    "longDescription": "pdfsign lets you open PDF documents, place handwritten signature images, fill form fields, and apply cryptographic PAdES signatures using a hardware smartcard (e.g. an electronic ID card or USB token via OpenSC).",
    "copyright": "Copyright (c) 2024 pdfsign contributors",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": null,
      "entitlements": "./entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": ["opensc"]
      },
      "rpm": {
        "depends": ["opensc"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {
    "shell": {
      "open": false
    }
  }
}
